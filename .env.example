# Copy to .env (gitignored). Loaded by agent/main.py and agent/ui.py via load_dotenv().

# --- Gemini on Vertex AI (ADC, no Gemini API key) ---
# Required: GCP project with Vertex AI API enabled.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional. Default us-central1.
GOOGLE_CLOUD_LOCATION=us-central1

# Optional. Default gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Required for Vertex generateContent (not Gemini Developer / Agent Platform).
# agent/llm.py also sets this to true at runtime.
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Shares sub-agent (Alpha Vantage) ---
# Required for stock/quote/overview/news tools. Do not commit the real key.
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your-alphavantage-key

# --- Weather sub-agent (Open-Meteo) ---
# No env var. Public forecast/geocoding/air-quality HTTP, no API key.
