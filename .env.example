# Copy to .env (gitignored). Loaded via pydantic-settings and python-dotenv.

# --- Gemini on Vertex AI (ADC, no Gemini API key) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Shares specialist (Alpha Vantage) ---
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your-alphavantage-key

# --- Weather specialist (Open-Meteo) ---
# No env var. Public HTTP, no API key.

# --- Local identity (stand-in for SSO). * = every catalogued agent. ---
DEFAULT_USER_ID=local-dev
DEFAULT_TENANT_ID=local
DEFAULT_ROLE=admin
DEFAULT_SCOPES=*
